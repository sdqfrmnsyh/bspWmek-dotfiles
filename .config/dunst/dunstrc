[global]
    width = 300
    height = 300
    origin = bottom-right
    offset = 8x8
    scale = 0
    notification_limit = 5

    # --- TAMPILAN NETRAL ---
    transparency = 10       # Sedikit transparan agar menyatu dengan background
    separator_height = 1    # Garis pemisah tipis
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 0
    
    # Warna border netral (Abu-abu medium)
    frame_width = 1
    frame_color = "#4a4a4a" 
    separator_color = frame
    
    # Sudut membulat agar terlihat modern
    corner_radius = 8 

    # Font (Gunakan font monospaced)
    font = Inter Reguler 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"

    # Ikon
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

# --- LEVEL BAWAH (Info ringan seperti volume/brightness) ---
[urgency_low]
    background = "#1a1a1a"  # Abu-abu sangat gelap
    foreground = "#a0a0a0"  # Teks abu-abu terang
    timeout = 5

# --- LEVEL NORMAL (Notifikasi chat, dll) ---
[urgency_normal]
    background = "#242424"  # Abu-abu gelap (Charcoal)
    foreground = "#e0e0e0"  # Putih tulang (Off-white) agar tidak terlalu menyilaukan
    timeout = 10

# --- LEVEL KRITIS (Peringatan error/baterai habis) ---
[urgency_critical]
    background = "#2d2d2d"  # Sedikit lebih terang untuk menarik perhatian
    foreground = "#ffffff"  # Putih bersih
    frame_color = "#888888" # Border abu-abu terang
    timeout = 0
