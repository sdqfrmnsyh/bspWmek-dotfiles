* {
    bg0: rgba(30, 30, 30, 0.95);    
    bg1: rgba(255, 255, 255, 0.08); 
    bg2: rgba(255, 255, 255, 0.18); 
    bg3: rgba(255, 255, 255, 0.15); 
    fg0: #ffffff;                   
    fg1: #a1a1a6;                   
    red: #ff453a;
    
    background-color: transparent;
    text-color: @fg0;
}

window {
    width: 240px;        
    background-color: @bg0;
    border-radius: 16px; 
    border: 1px;
    border-color: @bg3;
    padding: 10px;
}


inputbar {
    enabled: false;
}
entry {
    enabled: false; 
}

mainbox {
    children: [ listview ]; 
}

listview {
    lines: 6;
    columns: 1;          
    spacing: 4px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 12px 15px;
    border-radius: 8px;
    orientation: horizontal; 
    children: [ element-text ];
}

/* Warna saat di-hover */
element selected {
    background-color: @bg2;
}

element selected urgent {
    background-color: @red;
    text-color: #ffffff;
}

element-icon {
    enabled: false;
}

element-text {
    text-color: inherit;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}
