	* {
    font:   "IBM Plex Mono 12";

    well:     #55181818;
    nord0:     #2e3440;
    nord1:     #3b4252;
    nord2:     #434c5e;
    nord3:     #4c566a;

    nord4:     #d8dee9;
    nord5:     #e5e9f0;
    nord6:     #eceff4;

    nord7:     #8fbcbb;
    nord8:     #88c0d0;
    nord9:     #81a1c1;
    nord10:    #5e81ac;
    nord11:    #bf616a;

    nord12:    #d08770;
    nord13:    #ebcb8b;
    nord14:    #a3be8c;
    nord15:    #b48ead;

    background-color: transparent;

    background: #6d6d78;
    foreground: #ececec;

    selected-bg: #efefef;
    selected-fg: #3b3b3b;

    border-color: #efefef;

    text-color:         @nord4;
    accent-color:       @nord8;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    background-color:   @well;
    border-color: #d8dee9;
    
    location:   center;
    width:     180px;
    border:     1px;
    border-radius    : 0px;
}

inputbar {
    enabled: false;
}

element-text, element-icon {
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

mainbox {
    children: [ listview ]; /* Memaksa rofi hanya merender daftar menu */
}

entry {
    enabled: false; /* Mematikan komponen input teks */
}

listview {
    lines:      6;
    columns:    1;

    fixed-height:   false;
}

element {
    padding: 10px;
    spacing: 10px;
}

element-icon {
    enabled: false;
}

element normal urgent {
    text-color: @nord13;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}


element selected {
    text-color: #2e3440;
}

element selected normal {
    background-color: #d8dee9;
}

element selected active {
    background-color: #d8dee9;
}

element selected urgent {
    background-color: #bf616a;
    text-color: #eceff4;
}

element-icon {
    size:   0.75em;
}

element-text {
    text-color: inherit;
    horizontal-align: 0.5;
}
