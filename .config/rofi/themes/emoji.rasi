* {
    bg0: rgba(30, 30, 30, 0.95);    
    bg1: rgba(255, 255, 255, 0.08); 
    bg2: rgba(255, 255, 255, 0.18); 
    bg3: rgba(255, 255, 255, 0.15); 
    fg0: #ffffff;                   
    fg1: #a1a1a6;                   
    background-color: transparent;
    text-color: @fg0;
}

window {
    width: 420px;
    background-color: @bg0;
    border-radius: 16px; 
    border: 1px;
    border-color: @bg3;
    padding: 15px;
}

inputbar {
    background-color: @bg1;
    border: 1px;
    border-color: @bg3;
    border-radius: 10px;
    padding: 8px 12px;
    margin: 0px 5px 15px 5px; 
    children: [icon-search, entry]; 
}

icon-search {
    expand: false;
    filename: "search-symbolic";
    size: 16px;
    margin: 0px 10px 0px 0px; 
}

entry {
    placeholder: "Search";
    placeholder-color: @fg1;
}

listview {
    columns: 6;
    lines: 5;
    spacing: 0px;
    fixed-columns: true;
    dynamic: true;       
    scrollbar: false;    
}

element {
    padding: 2px;
    border-radius: 8px;
    orientation: vertical; 
}

element selected {
    background-color: @bg2;
}

element-icon {
    size: 0px;
    padding: 0px;
    margin: 0px;
}

element-text {
    font: "sans-serif 32"; 
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 0px;
}
