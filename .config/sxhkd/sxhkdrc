# ----------------------------------------------------------
# Applications
# ----------------------------------------------------------

# Application launcher
super + r
    ~/.scripts/rofi.sh rice &

# Emoji picker
super + period
    ~/.scripts/rofi.sh emoji &

# Power menu
super + Escape
    ~/.scripts/rofi.sh power &

# File manager
XF86Explorer
    pcmanfm &

# Calculator
XF86Calculator
    kitty &

# Mission Center
ctrl + shift + Escape
    missioncenter &


# ----------------------------------------------------------
# BSPWM
# ----------------------------------------------------------

# Close window
alt + F4
    bspc node -c &
    
# Focus window
super + Left
    bspc node -f west &

super + Right
    bspc node -f east &

super + Up
    bspc node -y north &

super + Down
    bspc node -y south &
    
# Move / swap window
super + shift + Left
    bspc node -s west &

super + shift + Right
    bspc node -s east &

super + shift + Up
    bspc node -s north &

super + shift + Down
    bspc node -s south &


# ----------------------------------------------------------
# Workspace
# ----------------------------------------------------------

# Switch workspace
super + {1-9}
    bspc desktop -f '^{1-9}' &

# Send window to workspace
super + shift + {1-9}
    bspc node -d '^{1-9}' &


# ----------------------------------------------------------
# Window shortcuts
# ----------------------------------------------------------

# Fullscreen
super + f
    bspc node -t ~fullscreen &
    
# floating
super + x
    bspc node -t ~floating &
    
# Minimize
super + z
    bspc node -g hidden=on &

# Restore hidden window
super + shift + z
    bspc node "$(bspc query -N -n .hidden | head -n 1)" -g hidden=off &
    
# ----------------------------------------------------------
# Screenshots
# ----------------------------------------------------------

# Full screenshot
Print
    ~/.scripts/screenshot.sh full &

# Delayed screenshot
ctrl + Print
    ~/.scripts/screenshot.sh countdown &

# Active window
alt + Print
    ~/.scripts/screenshot.sh window &

# Area screenshot
super + shift + s
    ~/.scripts/screenshot.sh area &


# ----------------------------------------------------------
# Multimedia
# ----------------------------------------------------------

XF86AudioRaiseVolume
    ~/.scripts/change-volume.sh + &

XF86AudioLowerVolume
    ~/.scripts/change-volume.sh - &

XF86AudioMute
    ~/.scripts/change-volume.sh 0 &

XF86AudioPlay
    playerctl play-pause &

XF86AudioStop
    playerctl stop &

XF86AudioNext
    playerctl next &

XF86AudioPrev
    playerctl previous &


# ----------------------------------------------------------
# Brightness
# ----------------------------------------------------------

XF86MonBrightnessUp
    ~/.scripts/change-brightness.sh + &

XF86MonBrightnessDown
    ~/.scripts/change-brightness.sh - &


# ----------------------------------------------------------
# Wac Utilities
# ----------------------------------------------------------

# Wallpaper
XF86HomePage
    ~/.local/bin/walper &

# Toggle Picom
Pause
    ~/.scripts/picom.sh &

super + ctrl + shift + asciitilde
    ~/.scripts/picom.sh &

# Refresh display profile
super + ctrl + shift + b
    ~/.scripts/display.sh &


# ----------------------------------------------------------
# Extra
# ----------------------------------------------------------

# Restart BSPWM
super + alt + r
    bspc wm -r

# Quit BSPWM
super + alt + q
    bspc quit

# Reload SXHKD
super + alt + s
    pkill -USR1 -x sxhkd
